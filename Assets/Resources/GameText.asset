%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6616237b361d5244a91a8170dc00d6e6, type: 3}
  m_Name: GameText
  m_EditorClassIdentifier: 
  openingMonologue:
  - "\u597D\u51B7......\u6211\u600E\u4E48\u5728\u8FD9\u9192\u8FC7\u6765\uFF0C"
  - "\u96E8\u7684\u5473\u9053\u597D\u91CD\uFF0C\u4E0B\u96E8\u4E86\u5417"
  - "\u5BF9\u4E86\uFF0C\u662F\u4E0B\u96E8\u4E86\uFF0C\u6211\u8981\u7ED9\u5988\u5988\u53D6\u4E1C\u897F\u6765\u7740\uFF0C\u662F\u4EC0\u4E48\u6765\u7740......"
  - "\u7B97\u4E86\uFF0C\u5988\u8FD8\u5728\u5BB6\u7B49\u6211\uFF0C\u5148\u56DE\u53BB\u95EE\u95EE\u5427"
  - "\u95E8\u7F1D\u91CC\u90FD\u8FD8\u900F\u7740\u5149\uFF0C\u5514\uFF0C\u5927\u5BB6\u5E94\u8BE5\u90FD\u8FD8\u6CA1\u7761\u3002\u4ED6\u4EEC\u7684\u4E1C\u897F\u600E\u4E48\u90FD\u8FD8\u653E\u5728\u5916\u9762\uFF1F\u4E0B\u96E8\u4E86\uFF0C\u4F1A\u6DCB\u6E7F\u7684......"
  - "\u90A3\u5C31\u5E2E\u4ED6\u4EEC\u6536\u4E00\u6536\u5427\u3002\u90FD\u662F\u4E9B\u5FD8\u4E86\u6536\u7684\u4E1C\u897F"
  tutorialA1: "\u95E8\u662F\u8FDB\u4E0D\u53BB\u7684\u3002\u6211\u53EA\u80FD\u5728\u697C\u9053\u548C\u9662\u5B50\u91CC\u8D70\u8D70"
  tutorialA2: "\uFF08\u7528\u65B9\u5411\u952E\u8D70\uFF09"
  tutorialA3: "\u4ED6\u4EEC\u7684\u4E1C\u897F\u5C31\u653E\u5728\u90A3\u513F\uFF0C\u8C01\u4E5F\u6CA1\u6536"
  tutorialB1: "\u8FD9\u4E2A\u4E1C\u897F...\u6211\u597D\u50CF\u80FD\u78B0\u5230"
  tutorialB2: "\u8FD9\u4EF6\u7269\u54C1\u4F3C\u4E4E\u56E0\u4E3A\u6211\u7684\u89E6\u78B0\u53D1\u751F\u4E86\u4E9B\u6539\u53D8"
  tutorialC1: "\u6709\u4EBA\u51FA\u6765\u4E86"
  tutorialC2: "\u4ED6\u628A\u5B83\u62FF\u56DE\u53BB\u4E86"
  tutorialC3: "\u597D\u50CF\u53EA\u80FD\u89E6\u78B01\u6B21\u3002\u90A3\u2026\u2026\u78B0\u54EA\u4E2A\u597D"
  tutorialD1: "\u5F97\u8D70\u8FD1\u4E00\u70B9\u624D\u78B0\u5F97\u5230"
  tutorialD2: "\u8FD9\u6247\u95E8\u4E00\u76F4\u662F\u5173\u7740\u7684"
  tutorialD3: "\u8FD9\u91CC\u6CA1\u4EC0\u4E48\u53EF\u78B0\u7684"
  forceTouchWarnings:
  - "\u771F\u662F\u5947\u602A\uFF0C\u8FD9\u4E1C\u897F\u53D8\u5F97\u597D\u91CD\uFF0C\u6211\u6CA1\u529E\u6CD5\u5E2E\u5FD9\u6536\u56DE\u53BB\uFF0C\u6211\u751F\u75C5\u4E86\u5417"
  - "\u8FD8\u662F\u5148\u4E0D\u8981\u52A8\u4E86\u5427\uFF0C\u4E5F\u8BB8\u8FD9\u5BB6\u4EBA\u662F\u6545\u610F\u653E\u5728\u8FD9\u7684\uFF1F"
  forceTouchAccepted:
  - "\u554A\uFF01\u62B1\u6B49\uFF0C\u6211\u4E0D\u4E71\u52A8\u4E86"
  - "\u5BF9\u4E0D\u8D77\uFF0C\u6211\u4EE5\u4E3A\u2026\u2026"
  - "\u4E0D\u597D\u610F\u601D\uFF0C\u6211\u79BB\u8FDC\u4E00\u70B9"
  forceTouchHeavy: "\u5443\u554A\uFF0C\u597D\u75DB\uFF0C\u8FD8\u662F\u4E0D\u8981\u4E71\u52A8\u4E86\uFF0C\u7838\u5230\u624B\u5C31\u4E0D\u597D\u4E86"
  alreadyTouched: "\u5DF2\u7ECF\u6536\u597D\u4E86\uFF0C\u4E0D\u9700\u8981\u518D\u52A8\u4E86"
  placementBlockedClothes: "\u521A\u6D17\u597D\u7684\u8863\u670D\uFF0C\u4E0D\u80FD\u653E\u5728\u5730\u4E0A"
  placementBlockedMedicineBag: "\u5730\u4E0A\u90FD\u662F\u6C34\uFF0C\u653E\u5730\u4E0A\u7684\u8BDD\u5F97\u51B2\u6D17\u836F\u5305\uFF0C\u8FD8\u662F\u4E0D\u8981\u653E\u5728\u5730\u4E0A\u4E86\u5427"
  placementBlockedWoodenBox: "\u597D\u6C89......\u770B\u6765\u6211\u642C\u4E0D\u52A8\u5B83\uFF0C\u5C31\u653E\u5728\u5730\u4E0A\u5427"
  itemMonologues:
  - itemId: grandma_01
    text: "\u8896\u53E3\u8865\u8FC7\u4E00\u6B21\uFF0C\u9488\u811A\u5F88\u5BC6\u3002\u8FD9\u8863\u670D\u7684\u4E3B\u4EBA\u9488\u7EBF\u6D3B\u5F88\u597D\uFF0C\u5E94\u8BE5\u4E5F\u662F\u90A3\u79CD\u5F88\u6709\u8010\u5FC3\u7684\u4EBA"
  - itemId: grandma_02
    text: "\u82B1\u5F00\u5F97\u4E0D\u7B97\u597D\uFF0C\u4F46\u4E00\u7247\u67AF\u53F6\u90FD\u6CA1\u6709\uFF0C\u517B\u5B83\u7684\u4EBA\u4E00\u5B9A\u5F88\u7EC6\u5FC3"
  - itemId: grandma_03
    text: "\u7EB8\u89D2\u6298\u5F97\u6574\u6574\u9F50\u9F50\u3002\u770B\u6837\u5B50\u4E3B\u4EBA\u5F88\u6709\u6761\u7406"
  - itemId: aunt_01
    text: "\u8FD9\u4E2A\u82B1\u76C6\u91CC\u7684\u82B1\u957F\u5F97\u6709\u70B9\u6B6A\u554A......\u4E3B\u4EBA\u597D\u50CF\u5E76\u672A\u6089\u5FC3\u6253\u7406"
  - itemId: aunt_02
    text: "\u8FD9\u6728\u96D5\u8FD9\u4E48\u7CBE\u7F8E\uFF0C\u4E00\u5B9A\u662F\u4E00\u4F4D\u70ED\u7231\u6728\u96D5\u7684\u4EBA\u6240\u62E5\u6709\u7684\u5427"
  - itemId: aunt_03
    text: "\u5916\u9762\u810F\u5F97\u5F88\uFF0C\u91CC\u9762\u5DE5\u5177\u5374\u6392\u5217\u7684\u5F88\u6574\u9F50\uFF0C\u8FD9\u4E2A\u5305\u7684\u4E3B\u4EBA\u4F1A\u4E0D\u4F1A\u4E5F\u5F88\u6709\u53CD\u5DEE\uFF1F"
